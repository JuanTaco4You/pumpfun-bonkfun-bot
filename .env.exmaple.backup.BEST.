# This file defines comprehensive parameters and settings for the trading bot.
# Carefully review and adjust values to match your trading strategy and risk tolerance.

# Bot identification and connection settings
name: "bot-sniper-2"
env_file: ".env"
rpc_endpoint: "${SOLANA_NODE_RPC_ENDPOINT}"
wss_endpoint: "${SOLANA_NODE_WSS_ENDPOINT}"
private_key: "${SOLANA_PRIVATE_KEY}"

enabled: true
separate_process: true

# Options: "pump_fun" (default), "lets_bonk"
platform: "pump_fun"

# Geyser configuration (not used with listener_type: "logs")
geyser:
  endpoint: ""
  api_token: ""
  auth_type: ""

# Trading parameters
# Control trade execution: amount of SOL per trade and acceptable price deviation
trade:
  buy_amount: 0.01            # SOL per buy (keeps fees small relative to size)
  buy_slippage: 0.05          # 5% entry slippage for reliable first-block fills
  sell_slippage: 0.08         # 8% exit slippage to avoid stuck sells

  # Exit strategy configuration
  exit_strategy: "tp_sl"      # "time_based", "tp_sl", "manual"
  take_profit_percentage: 0.18  # +18% TP: frequent small wins > home runs
  stop_loss_percentage: 0.09    # -9% SL: cut losers quickly before decay
  max_hold_time: 50           # seconds; hard flat if no TP/SL hit
  price_check_interval: 1     # seconds; responsive exits

  # EXTREME FAST mode configuration
  # When enabled, skips bonding-curve stabilization & RPC price check.
  # Faster but riskier. Keep off for safer fills.
  extreme_fast_mode: false
  # extreme_fast_token_amount: 20

# Priority fee configuration
# Dynamic estimator + modest uplift; cap to protect EV under congestion.
priority_fees:
  enable_dynamic: true        # estimate from recent txs (WS logs path is still fast)
  enable_fixed: false         # use dynamic, not fixed
  fixed_amount: 250_000       # ignored unless enable_fixed: true
  extra_percentage: 0.10      # +10% over estimator; enough to beat the pack
  hard_cap: 500_000           # µLamports cap; prevents runaway fees (was 600k)

# Filters for token selection
filters:
  match_string: null          # optional allow filter by name/symbol
  bro_address: null           # optional allow filter by creator address
  listener_type: "logs"       # WebSocket logsSubscribe; fastest without Geyser
  max_token_age: 12.0         # only snipe very fresh mints (<=12s)
  marry_mode: false           # do not bag-hold; we sell
  yolo_mode: false            # no continuous chaining; one-at-a-time discipline

# Retry and timing settings
retries:
  max_attempts: 5             # tx submit retries
  wait_after_creation: 2.0    # small pause so accounts/PDAs propagate
  wait_after_buy: 3           # minimal settle before evaluating exit
  wait_before_new_token: 3    # recycle quickly once flat

# Token and account management
cleanup:
  # "disabled" | "on_fail" | "after_sell" | "post_session"
  mode: "post_session"
  force_close_with_burn: false
  with_priority_fee: true     # speed up cleanup; negligible cost

# Node provider configuration (not implemented)
node:
  max_rps: 25
